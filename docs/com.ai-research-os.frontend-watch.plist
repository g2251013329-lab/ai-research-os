<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-research-os.frontend-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mathew/dsh/ai-research-os/frontend/node_modules/.bin/vite</string>
        <string>build</string>
        <string>--watch</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mathew/dsh/ai-research-os/frontend</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
